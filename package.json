{
  "name": "kirimase",
  "version": "0.0.60",
  "description": "A Rails-like CLI for building full-stack Next.js apps faster",
  "type": "module",
  "bin": {
    "kirimase": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "cli",
    "nextjs",
    "drizzle",
    "next-auth",
    "rails",
    "shadcn",
    "authjs"
  ],
  "author": "Nico Albanese",
  "license": "ISC",
  "dependencies": {
    "@clack/core": "^0.3.3",
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "consola": "^3.4.2",
    "karozu": "^0.0.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.2",
    "tsup": "^8.4.0",
    "typescript": "^5.2.2",
    "vitest": "^3.1.1"
  }
}
